{
  "name": "jobtrackr-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "carbon:css": "sass app/carbon.scss app/carbon.css --load-path=node_modules --no-source-map",
    "predev": "npm run carbon:css",
    "prebuild": "npm run carbon:css",
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@carbon/icons-react": "^11.88.0",
    "@carbon/react": "^1.116.0",
    "@dnd-kit/core": "^6.3.1",
    "@sentry/nextjs": "^10.75.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sass": "^1.104.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.19",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4",
    "vitest": "^5.0.1"
  }
}
