{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "PowerShell(git status:*)",
      "Bash(git diff:*)",
      "PowerShell(git diff:*)",
      "Bash(git log:*)",
      "PowerShell(git log:*)",
      "Bash(npx tsc --noEmit:*)",
      "PowerShell(npx tsc --noEmit:*)",
      "Bash(npm test:*)",
      "PowerShell(npm test:*)",
      "Bash(npm run build:*)",
      "PowerShell(npm run build:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "PowerShell(git push:*)",
      "Bash(npx prisma migrate:*)",
      "PowerShell(npx prisma migrate:*)",
      "Bash(npx prisma db push:*)",
      "PowerShell(npx prisma db push:*)",
      "Bash(curl -X POST:*)",
      "PowerShell(curl -X POST:*)",
      "Bash(curl -X PUT:*)",
      "PowerShell(curl -X PUT:*)",
      "Bash(curl -X PATCH:*)",
      "PowerShell(curl -X PATCH:*)",
      "Bash(curl -X DELETE:*)",
      "PowerShell(curl -X DELETE:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "PowerShell(git push --force:*)",
      "Bash(git push -f:*)",
      "PowerShell(git push -f:*)",
      "Bash(git reset --hard:*)",
      "PowerShell(git reset --hard:*)",
      "Bash(rm -rf:*)",
      "PowerShell(rm -rf:*)",
      "PowerShell(Remove-Item -Recurse:*)",
      "Read(**/.env)",
      "Read(**/.env.*)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/audit.mjs\" hook"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/audit.mjs\" hook"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/guardas.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/audit.mjs\" hook"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/eval/recordatorios.mjs\" edicion"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/eval/recordatorios.mjs\" inicio"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/audit.mjs\" hook"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|PowerShell|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/audit.mjs\" hook"
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/audit.mjs\" hook"
          }
        ]
      }
    ]
  }
}
